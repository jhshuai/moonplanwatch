readme = "README.md"

description = "Conservative offline PostgreSQL 18 plan policy and regression checks"

keywords = [ "postgresql", "explain", "ci", "query-plan", "regression" ]

preferred_target = "wasm"

supported_targets = "+wasm+wasm-gc+js+native"
