----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

async fn main {
  guard @env.args() is [_, psql, destination] else {
    fail("Usage: moon run scripts/cardinality-e2e.mbtx PSQL NEW_DIRECTORY")
  }
  let repo = @fs.realpath(".")
  let version = @shell.Cmd(psql, ["-X", "-qAt", "-v", "ON_ERROR_STOP=1", "-c", "SHOW server_version_num"]).output(timeout_ms=15000)
  version.check()
  let numeric = version.stdout().trim().to_owned()
  guard numeric.length() == 6 && numeric.has_prefix("18") else {
    fail("This example requires PostgreSQL 18")
  }
  @fs.mkdir(destination)
  let root = @fs.realpath(destination)
  @shell.Cmd(psql, [
    "-X", "-qAt", "-v", "before_file=before.json", "-v", "after_file=after.json",
    "-f", repo + "/examples/cardinality/reproduce.sql",
  ], cwd=root, stdout=Inherit, stderr=Inherit).run(timeout_ms=60000)
  let context = @json.parse(@fs.read_text("examples/cardinality/context.json"))
  guard context is Object(fields) else { fail("Example context must be an object") }
  fields["server_version"] = Json::string("18." + numeric[2:].trim_start(chars="0").to_owned())
  if numeric == "180000" { fields["server_version"] = Json::string("18.0") }
  @fs.write_text(root + "/context.json", context.stringify() + "\n", create_mode=CreateNew)
  @shell.Cmd("moon", [
    "run", "scripts/e2e.mbtx", "wasm", "examples/chinook", root,
  ], stdout=Inherit, stderr=Inherit).run(timeout_ms=180000)
  println("Live PostgreSQL verified cardinality correction and nested-loop evidence")
}
